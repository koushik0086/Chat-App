# Frontend deployment variables
# Set these in Vercel project settings to the live Render backend URL.
# Example: https://chat-app-backend.onrender.com
VITE_API_URL=https://your-render-backend-url.onrender.com
VITE_SOCKET_URL=https://your-render-backend-url.onrender.com

# Optional alias kept for compatibility with older setups.
# If this is set, it will be used when VITE_API_URL is not defined.
VITE_BACKEND_URL=https://your-render-backend-url.onrender.com
