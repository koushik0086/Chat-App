# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────
# Replace with your Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── URLs ─────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Your Render backend URL (no trailing slash)
# This is used to build correct file upload URLs
BACKEND_URL=https://your-api.onrender.com

# Optional: Cloudinary for image/file uploads
# If omitted, the app will still run and text chat will work,
# but file upload endpoints will return a clear error.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
